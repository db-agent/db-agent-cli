<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner"><AutoRefresh>0</AutoRefresh><DataSources><DataSource Name="AdventureWorks"><ConnectionProperties><DataProvider>SQL</DataProvider><ConnectString>Data Source=sql2017.example.local;Initial Catalog=AdventureWorks2017</ConnectString><IntegratedSecurity>true</IntegratedSecurity></ConnectionProperties><rd:SecurityType>Integrated</rd:SecurityType></DataSource></DataSources><DataSets><DataSet Name="Orders"><Query><DataSourceName>AdventureWorks</DataSourceName><CommandText>SELECT TOP (100) c.CustomerID, h.SalesOrderID, h.OrderDate, h.TotalDue FROM Sales.Customer c JOIN Sales.SalesOrderHeader h ON h.CustomerID = c.CustomerID WHERE c.TerritoryID = @TerritoryID ORDER BY h.OrderDate DESC</CommandText><QueryParameters><QueryParameter Name="@TerritoryID"><Value>=Parameters!TerritoryID.Value</Value></QueryParameter></QueryParameters></Query><Fields><Field Name="CustomerID"><DataField>CustomerID</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="SalesOrderID"><DataField>SalesOrderID</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="OrderDate"><DataField>OrderDate</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="TotalDue"><DataField>TotalDue</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet></DataSets><ReportSections><ReportSection><Body><ReportItems><Tablix Name="OrdersTable"><TablixBody><TablixColumns><TablixColumn><Width>1.3in</Width></TablixColumn><TablixColumn><Width>1.3in</Width></TablixColumn><TablixColumn><Width>1.3in</Width></TablixColumn><TablixColumn><Width>1.3in</Width></TablixColumn></TablixColumns><TablixRows><TablixRow><Height>0.25in</Height><TablixCells><TablixCell><CellContents><Textbox Name="h_Orders_0"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>CustomerID</Value><Style><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><Style /></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="h_Orders_1"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>SalesOrderID</Value><Style><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><Style /></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="h_Orders_2"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>OrderDate</Value><Style><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><Style /></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="h_Orders_3"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>TotalDue</Value><Style><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><Style /></Textbox></CellContents></TablixCell></TablixCells></TablixRow><TablixRow><Height>0.25in</Height><TablixCells><TablixCell><CellContents><Textbox Name="d_Orders_0"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!CustomerID.Value</Value><Style /></TextRun></TextRuns><Style /></Paragraph></Paragraphs><Style /></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="d_Orders_1"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!SalesOrderID.Value</Value><Style /></TextRun></TextRuns><Style /></Paragraph></Paragraphs><Style /></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="d_Orders_2"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!OrderDate.Value</Value><Style /></